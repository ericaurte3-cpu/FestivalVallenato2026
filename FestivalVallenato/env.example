# Copia este archivo como ".env" y ajusta los valores. NUNCA subas ".env" a git.
DJANGO_SECRET_KEY=cambia-esta-clave
# Solo para desarrollo local. En producción debe ser False (valor por defecto).
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=festival_votaciones
DB_USER=festival_user
DB_PASSWORD=pon_aqui_tu_contraseña
DB_HOST=127.0.0.1
DB_PORT=3306

# Producción (HTTPS): descomenta cuando el sitio se sirva por HTTPS.
# DJANGO_HTTPS=True
# DJANGO_CSRF_TRUSTED_ORIGINS=https://votaciones.ejemplo.org
